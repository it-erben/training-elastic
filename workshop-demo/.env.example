# === Lokaler Tag-3-Cluster (Security an, TLS) -- Standard fuer Lab 08 ===
ELASTIC_URL=https://localhost:9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=changeme
ELASTIC_TLS_VERIFY=false

